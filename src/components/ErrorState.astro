---
interface Props {
	code: string
	title: string
	message: string
	detail?: string
	retry?: boolean
}

const { code, title, message, detail, retry = false } = Astro.props
---

<main class="relative grid min-h-dvh place-items-center overflow-hidden px-6">
	<div class="pointer-events-none absolute top-[-25%] left-1/2 h-[640px] w-[980px] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(255,70,85,0.14),transparent)]"></div>

	<div class="relative flex max-w-[520px] flex-col items-center text-center">
		<p
			class="rise num display bg-gradient-to-b from-fg to-fg-4 bg-clip-text text-[120px] leading-none font-semibold text-transparent sm:text-[160px]"
			style="--d: 60ms"
		>
			{code}
		</p>
		<h1
			class="rise mt-4 text-[22px] font-semibold tracking-[-0.02em]"
			style="--d: 120ms"
		>
			{title}
		</h1>
		<p class="rise mt-2 text-[15px] text-fg-3" style="--d: 160ms">
			{message}
		</p>

		{detail && (
			<pre
				class="rise mt-6 max-h-48 w-full overflow-auto rounded-2xl bg-white/[0.04] p-4 text-left font-mono text-[12px] text-fg-3 ring-1 ring-line"
				style="--d: 200ms"
				set:text={detail}
			/>
		)}

		<div class="rise mt-8 flex gap-2" style="--d: 240ms">
			<a
				href="/"
				class="pressable rounded-full bg-fg px-5 py-2.5 text-[14px] font-medium text-bg"
			>
				Ir al inicio
			</a>
			{retry && (
				<button
					type="button"
					onclick="location.reload()"
					class="pressable rounded-full bg-white/[0.06] px-5 py-2.5 text-[14px] font-medium ring-1 ring-line hover:bg-white/[0.09]"
				>
					Reintentar
				</button>
			)}
		</div>
	</div>
</main>

<style>
	.rise {
		animation: rise 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: var(--d);
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(14px);
			filter: blur(6px);
		}
	}
</style>
