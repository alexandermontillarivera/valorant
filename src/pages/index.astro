---
import Layout from "@/layouts/Layout.astro"
import Profiles from "@/components/home/Profiles"
import ErrorState from "@/components/ErrorState.astro"
import { loadDashboard } from "@/lib/dashboard"
import { PLAYERS } from "@/lib/players"
import { getCatalog } from "@/lib/catalog"
import { filterGames, summarize } from "@/lib/stats"
import { leanSummary } from "@/lib/views"
import type { ProfileCard } from "@/interfaces/versus"

if (PLAYERS.length === 1) return Astro.redirect(`/p/${PLAYERS[0].slug}`)

const catalog = await getCatalog()
// Profiles still on their first sync render as placeholders instead of blocking the page.
const cards: ProfileCard[] = await Promise.all(
	PLAYERS.map(async (p) => {
		const result = await loadDashboard(p, false)
		if (!result.ok) return { ...p, ok: false, message: result.message }
		const games = filterGames(result.data.games, "competitive", "act")
		return {
			...p,
			ok: true,
			profile: result.data.profile,
			summary: leanSummary(summarize(games)),
			form: games.slice(0, 8).map((g) => g.result),
		}
	}),
)
---

<Layout title="Perfiles">
	{PLAYERS.length ? (
		<Profiles client:load cards={cards} catalog={catalog} />
	) : (
		<ErrorState
			code="500"
			title="Sin jugadores configurados"
			message='Define PLAYER_RIOT_IDS="Nombre#TAG,Otro#TAG" en el entorno.'
		/>
	)}
</Layout>
